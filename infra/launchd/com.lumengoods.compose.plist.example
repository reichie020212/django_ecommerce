<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Boot the Lumen stack via Docker Compose on macOS login.
  Install:
    cp infra/launchd/com.lumengoods.compose.plist.example ~/Library/LaunchAgents/com.lumengoods.compose.plist
    launchctl load ~/Library/LaunchAgents/com.lumengoods.compose.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.lumengoods.compose</string>
  <key>WorkingDirectory</key><string>/Users/REPLACE-ME/lumen-goods</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/docker</string>
    <string>compose</string>
    <string>-f</string>
    <string>docker-compose.yml</string>
    <string>-f</string>
    <string>docker-compose.prod.yml</string>
    <string>up</string>
    <string>-d</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><false/>
  <key>StandardOutPath</key><string>/tmp/lumengoods.compose.out</string>
  <key>StandardErrorPath</key><string>/tmp/lumengoods.compose.err</string>
</dict>
</plist>
