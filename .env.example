# ============================================================
# Lumen Goods — environment variables
# Copy to .env and fill in real values. .env is gitignored.
# ============================================================

# ── Django ──────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=lumen.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-50-char-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.lumen.local
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://lumen.local

# ── Database ────────────────────────────────────────────────
POSTGRES_DB=lumen
POSTGRES_USER=lumen
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://lumen:change-me@db:5432/lumen

# ── Redis / Celery ──────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Stripe ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ── Frontend ────────────────────────────────────────────────
# Server-side fetches inside the Next.js container go to the api service
# directly. Browser-side URLs use the host-exposed port.
INTERNAL_API_URL=http://api:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Email (transactional) ───────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Lumen Goods <hello@lumen.local>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=1

# ── CORS ────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://lumen.local

# ── Storage ─────────────────────────────────────────────────
MEDIA_ROOT=/var/lumen/media
STATIC_ROOT=/var/lumen/static
# S3-compatible (optional, for later):
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
