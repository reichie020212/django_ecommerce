# ============================================================
# Lumen Goods — environment variables
# Copy to .env and fill in real values. .env is gitignored.
# ============================================================

# ── Django ──────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=lumen.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-50-char-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.lumen.local
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://lumen.local

# ── Database ────────────────────────────────────────────────
# DATABASE_URL is the source of truth (read by django-environ). The
# POSTGRES_* vars only matter when the bundled postgres:16 container
# is used; for managed Postgres (Neon, RDS, Cloud SQL, Supabase) just
# set DATABASE_URL and ignore the rest.
POSTGRES_DB=lumen
POSTGRES_USER=lumen
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://lumen:change-me@db:5432/lumen

# ── Redis / Celery ──────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Stripe ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ── Frontend ────────────────────────────────────────────────
# Server-side fetches inside the Next.js container go to the api service
# directly. Browser-side URLs use the host-exposed port.
INTERNAL_API_URL=http://api:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Email (transactional) ───────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Lumen Goods <hello@lumen.local>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=1

# ── CORS ────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://lumen.local

# ── Logging ─────────────────────────────────────────────────
# JSON_LOGGING=1 emits structured JSON on stdout (for Loki/CloudWatch/etc).
# Default is plain text for dev. LOG_LEVEL applies to the root logger.
JSON_LOGGING=0
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO

# ── Storage ─────────────────────────────────────────────────
MEDIA_ROOT=/var/lumen/media
STATIC_ROOT=/var/lumen/static

# Media backend: 'local' (default) writes to MEDIA_ROOT on disk;
# 's3' writes via django-storages to any S3-compatible service.
MEDIA_BACKEND=local

# S3-compatible media (used when MEDIA_BACKEND=s3).
# Works with AWS S3, Cloudflare R2, Backblaze B2, and self-hosted MinIO.
#   - AWS S3: leave AWS_S3_ENDPOINT_URL empty, set AWS_S3_REGION_NAME.
#   - Cloudflare R2: AWS_S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com,
#     AWS_S3_REGION_NAME=auto. R2 charges $0 egress.
#   - MinIO: AWS_S3_ADDRESSING_STYLE=path.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=lumen-media
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_ADDRESSING_STYLE=virtual
AWS_QUERYSTRING_AUTH=0
